# wechat-ex-fusion 环境变量（可选）
# 复制本文件为 .env 后生效（.env 已被 .gitignore 排除，不会上传）。
# 不设置时，脚本会使用「融合项目」默认值：数据在 her/、人设在 exes/、结果在 exports/，全部跟随本项目目录、已 gitignore。

# bot 的数据目录（会话/config/accounts 存这里）。留空则用 <项目根>/her/.wcc
WCC_DATA_DIR=

# 融合项目根目录，用于定位 her/work 与 exes。留空则用 <项目根>/
FUSION_ROOT=

# 前任人设目录。留空则为 <FUSION_ROOT>/exes 或 <WCC_DATA_DIR>/exes
EXES_DIR=

# 指向具体某个人设（目录名）。只有一个时留空，会自动探测。
# 例如：HER_SLUG=xiaomeng
HER_SLUG=
